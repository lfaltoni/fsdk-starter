# Required
SECRET_KEY=dev-secret-change-in-production
DB_NAME=instance/starter.db
ENVIRONMENT=development   # development | testing | production (anything else refuses to boot)

# App branding
APP_NAME=FSDK Starter
BASE_URL=http://localhost:5001

# Email
# Without RESEND_API_KEY, dev/testing log emails to the console (not sent);
# production refuses to boot. EMAIL_FROM is the From address for all mail
# (dev falls back to noreply@localhost; production must set a verified sender).
RESEND_API_KEY=
EMAIL_FROM=

# Google SSO — leave empty to disable
GOOGLE_CLIENT_ID=

# MFA — set a key to enable MFA endpoints (any string, 16+ chars)
MFA_HMAC_KEY=fsdk-starter-dev-mfa-hmac-key-32

# Optional domains — set to "true" to enable
ENABLE_BILLING=false
ENABLE_TENANCY=false
ENABLE_LLM=false

# CORS
CORS_ORIGINS=http://localhost:3000
